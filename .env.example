# Public, non-secret configuration required only when the Supabase application
# boundary is invoked. Development values belong in an unversioned local env file.
NEXT_PUBLIC_SUPABASE_URL=https://project.example.invalid
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_invalid_do_not_use

# Server-only TASK-013 configuration. Use unrelated high-entropy values locally.
SUPABASE_SECRET_KEY=sb_secret_example_invalid_do_not_use
AUTH_CHALLENGE_HMAC_ACTIVE_VERSION=v1
AUTH_CHALLENGE_HMAC_KEY_V1=example_invalid_challenge_key_material_replace_locally
AUTH_TECHNICAL_PASSWORD_ACTIVE_VERSION=v1
AUTH_TECHNICAL_PASSWORD_KEY_V1=example_invalid_technical_password_key_replace_locally
